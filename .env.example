# Copy to .env (never committed) or export these variables. No real values here.

# Public address people use to open minuteca (sign-in links point here).
MINUTECA_ORIGIN=http://localhost:8787
PORT=8787
HOST=127.0.0.1
# Behind a reverse proxy that sets X-Forwarded-For: 1. Otherwise leave empty.
TRUST_PROXY=

# Data: one SQLite file and a folder of audio files. Back them up like any other files.
MINUTECA_DB=./data/minuteca.sqlite
MINUTECA_FILES_DIR=./data/files

# Who can sign in from the start, as admins (comma separated). Admins add everyone else in the
# app (Users screen) or with `npm run access -- add someone@example.org`.
MINUTECA_ADMIN_EMAILS=

# Encrypts each person's own provider keys (Deepgram, AssemblyAI, OpenAI). 32 random bytes in
# base64, made with: openssl rand -base64 32
# Without it nobody can save a key. If you lose it, saved keys cannot be read: people paste them again.
MINUTECA_KEY_ENCRYPTION_KEY=

# Sign-in emails. "console" prints the link in the server log (fine for one person at home);
# "resend" sends real email and needs RESEND_API_KEY and MAIL_FROM.
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=

# How providers get the audio. Empty: automatic ("url" on https addresses, "upload" otherwise).
#   url:    providers download it from a private, short-lived link and call minuteca back when done
#           (the server must be reachable from the internet).
#   upload: minuteca sends the bytes and asks for the result (works on a home network).
MINUTECA_PROVIDER_AUDIO=
# Where a provider's answer becomes a transcript: "server" (default) or "client" (the browser).
MINUTECA_CONVERT=

# Minutes with AI: each person adds their own key (Claude, Gemini, OpenAI, OpenRouter) in Settings.
# Optional local model with an OpenAI compatible API (Ollama, LM Studio), for everyone on this server:
#   MINUTECA_LLM_LOCAL_URL=http://127.0.0.1:11434/v1   MINUTECA_LLM_LOCAL_MODEL=llama3.1
MINUTECA_LLM_LOCAL_URL=
MINUTECA_LLM_LOCAL_MODEL=
# Time zone for dates written in minutes.
MINUTECA_TZ=America/Costa_Rica

# Meetings, transcripts and audio are deleted after this many days.
MINUTECA_RETENTION_DAYS=30
# Largest audio upload, in MB.
MINUTECA_MAX_AUDIO_MB=95

# Build identifier shown by GET /health.
LZNO_CORE_SHA=
